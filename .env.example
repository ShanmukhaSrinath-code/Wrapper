# ---------------------------------------------------------------------------
# Common Application Base -- copy to .env and adjust.
# Values below are the docker-compose defaults.
# ---------------------------------------------------------------------------

# --- app ---
APP_NAME=common-app-base
ENVIRONMENT=local
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=true

# --- postgres ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
# Least-privilege role the application connects as (migrations use POSTGRES_USER).
POSTGRES_APP_USER=appruntime
POSTGRES_APP_PASSWORD=appruntimepassword
POSTGRES_DB=appdb
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=
CACHE_TTL_SECONDS=60

# --- object storage (MinIO, S3 API) ---
STORAGE_PROVIDER=minio
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=app-files
S3_REGION=us-east-1
S3_PRESIGN_EXPIRY_SECONDS=900

# --- celery (defaults to REDIS_URL when unset) ---
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# --- observability ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=common-app-base
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
METRICS_ENABLED=true
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- security ---
# Deny by default. Uncomment and name the browser origins that may call this
# API -- `*` is an explicit opt-in, not the fallback.
CORS_ALLOW_ORIGINS=
# CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
MAX_REQUEST_BODY_BYTES=10485760
HSTS_MAX_AGE_SECONDS=31536000

# --- rate limiting -----------------------------------------------------------
# A shared counter in Redis, so the number here is the number a caller actually
# gets no matter how many replicas are running. Fails open: losing Redis costs
# the safeguard, never uptime.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# Leave OFF unless a proxy you control rewrites the header. Trusting it blindly
# lets any caller forge a fresh identity per request and bypass the limit.
RATE_LIMIT_TRUST_FORWARDED_FOR=false

# --- outbound http -----------------------------------------------------------
# Timeouts are not optional: an unbounded outbound call turns a slow dependency
# into exhausted workers here.
HTTP_CONNECT_TIMEOUT_SECONDS=5.0
HTTP_READ_TIMEOUT_SECONDS=15.0
HTTP_MAX_RETRIES=2
# After this many consecutive failures to one host, calls fail fast for
# HTTP_BREAKER_RESET_SECONDS instead of queueing behind a dead dependency.
HTTP_BREAKER_ENABLED=true
HTTP_BREAKER_FAILURE_THRESHOLD=5
HTTP_BREAKER_RESET_SECONDS=30.0

# --- secrets provider (swap point: azure_key_vault) ---
SECRETS_PROVIDER=env
# AZURE_KEY_VAULT_URL=https://my-vault.vault.azure.net/
